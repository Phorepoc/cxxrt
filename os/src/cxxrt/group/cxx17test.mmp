// cxx17test.mmp -- a C++20 program on libstdc++ 13 (built from the GCC source over Open C by recipes/build_libstdcxx.sh):
// std::string, containers, threads, exceptions. The standard-C++ part is a PREBUILT archive (recipes/build_cxxtest.sh ->
// $PHOREPOC_BUILD/thirdparty/x86/cxxrt/*.a), linked through the registry's x32_archives.
TARGET			cxx17test.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7015770
CAPABILITY		None
EPOCHEAPSIZE	0x100000 0x1000000
EPOCSTACKSIZE	0x14000
OS_LAYER_SYSTEMINCLUDE_SYMBIAN
OS_LAYER_LIBC_SYSTEMINCLUDE
SOURCEPATH		..
SOURCE			cxxrt_main.cpp
STATICLIBRARY	libcrt0.lib
LIBRARY			libc.lib libm.lib libpthread.lib
LIBRARY			euser.lib
SMPSAFE
